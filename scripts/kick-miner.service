[Unit]
Description=Kick Miner Go — Channel Points Farm 24/7
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kick-miner
ExecStart=/home/ubuntu/kick-miner/kick-miner-linux
Restart=always
RestartSec=10s
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

# Otimizacoes de Memoria Go
Environment=GOGC=50

[Install]
WantedBy=multi-user.target
